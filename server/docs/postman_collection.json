    {
      "name": "0. System Health",
      "item": [
        {
          "name": "System Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Liveness and readiness health check returning database status and uptime."
          }
        }
      ]
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    if (json.token) {",
                  "        pm.environment.set('auth_token', json.token);",
                  "        console.log('Saved auth_token to environment');",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@britoschool.com\",\n  \"password\": \"adminPassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/login",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "login"]
            },
            "description": "Authenticates admin credentials, saves JWT token to environment."
          }
        },
        {
          "name": "Forgot Password (Send OTP)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@britoschool.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "forgot-password"]
            },
            "description": "Sends 6-digit OTP code to registered admin email (valid for 2 minutes)."
          }
        },
        {
          "name": "Reset Password with OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@britoschool.com\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"newSecurePass2026\",\n  \"confirmPassword\": \"newSecurePass2026\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/reset-password",
              "host": ["{{base_url}}"],
              "path": ["api", "admin", "reset-password"]
            },
            "description": "Verifies OTP and resets admin password using bcrypt."
          }
        }
      ]
    },
