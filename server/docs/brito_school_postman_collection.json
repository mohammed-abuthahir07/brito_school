{
  "info": {
    "_postman_id": "brito-school-api-v1",
    "name": "Brito School Management API",
    "description": "Complete API collection for the Brito School Management System. Base URL: http://localhost:5000. After running the Login request, the token is auto-saved to the {{admin_token}} variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('DB is CONNECTED', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.database.status).to.eql('CONNECTED');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Returns server health status, DB connectivity, memory, and disk metrics."
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has token', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.token).to.be.a('string');",
                  "  pm.collectionVariables.set('admin_token', json.token);",
                  "  console.log('Token saved:', json.token.substring(0, 20) + '...');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@britoschool.com\",\n  \"password\": \"admin@123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "login"
              ]
            },
            "description": "Authenticates admin and returns JWT token. Token is auto-saved to {{admin_token}}."
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@britoschool.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/forgot-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "forgot-password"
              ]
            },
            "description": "Sends OTP to the admin's registered email."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@britoschool.com\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"newPassword123\",\n  \"confirmPassword\": \"newPassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/reset-password",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "reset-password"
              ]
            },
            "description": "Resets admin password using OTP from email."
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get Dashboard Stats",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has dashboard object', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.be.true;",
                  "  pm.expect(json.dashboard).to.be.an('object');",
                  "  pm.expect(json.dashboard.announcements).to.be.an('object');",
                  "  pm.expect(json.dashboard.calendars).to.be.an('object');",
                  "  pm.expect(json.dashboard.galleries).to.be.an('object');",
                  "  pm.expect(json.dashboard.thirukkural).to.be.an('object');",
                  "  pm.expect(json.dashboard.generatedAt).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/dashboard",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "dashboard"
              ]
            },
            "description": "Returns aggregated stats: total counts and latest entries from all 5 tables."
          }
        }
      ]
    },
